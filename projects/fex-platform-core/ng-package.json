{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/fex-platform-core",
  "assets": [
    "./assets",
    "./styles",
    {
      "glob": "**/*",
      "input": "node_modules/ngx-phosphor-icons/icons/",
      "output": "./assets/icons/"
    }
